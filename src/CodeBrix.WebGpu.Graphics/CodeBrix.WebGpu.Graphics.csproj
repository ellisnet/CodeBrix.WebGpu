<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebGpu.Graphics</AssemblyName>
    <RootNamespace>CodeBrix.WebGpu.Graphics</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.WebGpu.Graphics.MitLicenseForever</PackageId>
    <Product>CodeBrix.WebGpu.Graphics</Product>
    <Title>CodeBrix.WebGpu.Graphics</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A small, friendly graphics layer over WebGPU for .NET: one context object owning (or sharing) the GPU device, typed buffers, textures, samplers, bind groups and WGSL shaders with readable compile errors, render and compute pipeline builders with vertex layouts derived from your structs, a batched 2D sprite and shape renderer, a lit 3D mesh renderer with cameras, depth and per-instance transforms, and presentation to any texture view, a headless render target or a window surface created from native window handles (X11, Wayland, Win32, Metal, Android). System.Numerics maths throughout; no windowing toolkit. Built on CodeBrix.WebGpu.Native.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebGpu</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebGpu</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>webgpu;wgsl;gpu;graphics;2d;3d;sprites;rendering;vulkan;metal;direct3d;CodeBrix</PackageTags>
  </PropertyGroup>

  <!--
    The CodeBrix.WebGpu.Native dependency has two forms (see MAINTAINER-README.txt, PUBLISHING THE
    GRAPHICS PACKAGE):

      * Default: a ProjectReference to the sibling project, for building and testing inside this repository.
      * With -p:WebGpuNativePackageVersion=<version>: a PackageReference to the PUBLISHED
        CodeBrix.WebGpu.Native.MitLicenseForever at exactly that version. Publish the Native package first,
        then pack this project with the switch, so the Graphics package depends on a Native version that exists
        on nuget.org (a ProjectReference would stamp the version the Native project computes at pack time,
        which never matches a published one).
  -->
  <ItemGroup Condition="'$(WebGpuNativePackageVersion)' == ''">
    <ProjectReference Include="..\CodeBrix.WebGpu.Native\CodeBrix.WebGpu.Native.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WebGpuNativePackageVersion)' != ''">
    <PackageReference Include="CodeBrix.WebGpu.Native.MitLicenseForever" Version="$(WebGpuNativePackageVersion)" />
  </ItemGroup>

  <!--
    The icon, LICENSE and the third-party notices come from the repo root and cover every package; the README
    and the agent guide are this package's OWN, living beside this csproj, because the root ones describe
    CodeBrix.WebGpu.Native. Files inside the project folder are already part of the SDK's default None glob,
    so they are packed with Update rather than Include.
  -->
  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="AGENT-README.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
