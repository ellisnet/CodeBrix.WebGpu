<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebGpu.Native</AssemblyName>
    <RootNamespace>CodeBrix.WebGpu.Native</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Keep the committed native libraries (and the generated include/ files) out of the SDK's default item globs. Without this they arrive as
      None items with no metadata AS WELL AS through the explicit item below, and the metadata-less copies
      win, so nothing reaches the package.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);runtimes\**;include\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.WebGpu.Native.MitLicenseForever</PackageId>
    <Product>CodeBrix.WebGpu.Native</Product>
    <Title>CodeBrix.WebGpu.Native</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>Thin, generated .NET bindings over a native WebGPU implementation (the wgpu engine) shipped inside the package: every C function as a blittable LibraryImport, every C struct with its exact layout (checked against the native library at load time), enums, bitflags, object handles and callback-info structs - nothing marshalled, nothing hidden. Adds native-device access for Vulkan, Direct3D 12 and Metal (get the backend objects behind a device or texture, wrap existing ones, transition texture states) for sharing a GPU device with other renderers, small sharing contracts so libraries built on it share one device and texture without referencing each other, and the C headers, a generated function table and versioned hand-off structs for native modules (Rust, C, C++) working on the same WebGPU objects. Native libraries for Windows x64 and ARM64, macOS Intel and Apple Silicon, Linux x64, ARM64 and RISC-V 64, and Android 13+ ARM64 and x64.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebGpu</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebGpu</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>webgpu;wgpu;gpu;graphics;compute;vulkan;metal;direct3d;native;interop;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    The native codebrix_wgpu libraries, each beside LICENSE-WgpuNative.txt. They are built by
    wgpu-native-tools/ and committed under runtimes/<rid>/native/; nothing here builds them. They are kept out
    of the SDK's default item globs above and named once here. See MAINTAINER-README.txt.
  -->
  <ItemGroup>
    <_WgpuNativeLibrary Include="runtimes\**\*" />

    <!--
      Packed into the standard NuGet runtimes layout, so NuGet gives an application the one native for the
      platform it is building for.

      The package path is the BARE "runtimes/" folder. NuGet appends the item's own recursive directory and
      file name to a package path that names a folder, so spelling %(RecursiveDir) out here as well produces
      runtimes/linux-x64/native/linux-x64/native/libcodebrix_wgpu.so. It is the one piece of this csproj
      worth checking the package for after any change - see MAINTAINER-README.txt.
    -->
    <None Include="@(_WgpuNativeLibrary)" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>

  <!--
    The C ABI for native modules (see NATIVE MODULES in AGENT-README.txt), packed flat under include/ at the
    package root - a folder NuGet hands to no consumer build and copies to no output. webgpu.h / wgpu.h / the
    hand-written codebrix_wgpu.h come straight from wgpu-native-tools/ (the headers the natives are built from);
    codebrix_wgpu_procs.h / .rs are generated into include/ here by the binding generator. The licence covers
    webgpu.h (BSD-3-Clause) and wgpu.h (MIT); codebrix_wgpu*.h / .rs are this package's MIT code.
  -->
  <ItemGroup>
    <None Include="..\..\wgpu-native-tools\wgpu-native\ffi\webgpu-headers\webgpu.h" Pack="true" PackagePath="include\" />
    <None Include="..\..\wgpu-native-tools\wgpu-native\ffi\wgpu.h" Pack="true" PackagePath="include\" />
    <None Include="..\..\wgpu-native-tools\codebrix-wgpu\include\codebrix_wgpu.h" Pack="true" PackagePath="include\" />
    <None Include="include\codebrix_wgpu_procs.h" Pack="true" PackagePath="include\" />
    <None Include="include\codebrix_wgpu_procs.rs" Pack="true" PackagePath="include\" />
    <None Include="..\..\wgpu-native-tools\licenses\LICENSE-WgpuNative.txt" Pack="true" PackagePath="include\" />
  </ItemGroup>

</Project>
