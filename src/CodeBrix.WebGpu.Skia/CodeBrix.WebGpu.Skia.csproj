<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.WebGpu.Skia</AssemblyName>
    <RootNamespace>CodeBrix.WebGpu.Skia</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CodeBrix.WebGpu.Skia.MitLicenseForever</PackageId>
    <Product>CodeBrix.WebGpu.Skia</Product>
    <Title>CodeBrix.WebGpu.Skia</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>WebGPU rendering straight into SkiaSharp surfaces. Give it an SKSurface, an SKCanvas, a GRContext or nothing at all and it picks the fastest way to get WebGPU pixels onto it - zero copy when the surface lives on the same GPU device (Vulkan, Direct3D 12 or Metal), one GPU-side draw when it lives on the same device but its own texture cannot be shared, a CPU readback otherwise - and reports which one it took and why. Can create the GPU device and a SkiaSharp GRContext on it, or adopt the Vulkan or Metal device behind an application's own GRContext. Explicit, documented frame protocol for handing the texture between WebGPU and Skia; headless rendering to SKImage, SKBitmap or bytes. Built on CodeBrix.WebGpu.Native.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.WebGpu</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.WebGpu</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>webgpu;skia;skiasharp;gpu;graphics;vulkan;metal;direct3d;zero-copy;CodeBrix</PackageTags>
  </PropertyGroup>

  <!--
    SkiaSharp only: no SkiaSharp.* siblings and no NativeAssets package. The consuming application supplies
    the SkiaSharp native assets for its platforms (SkiaSharp.NativeAssets.Linux and so on).
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <!--
    CodeBrix.WebGpu.Native is normally consumed as the PUBLISHED package rather than a ProjectReference: a
    ProjectReference would stamp into this package's nuspec the version the Native project computes at pack
    time (its date-stamped minute), a version that was never published. See MAINTAINER-README.txt,
    PUBLISHING THE SKIA PACKAGE.

    Take care that no local folder is configured as a NuGet source holding a freshly-built Native package.
    Every Native build restamps its version, so a local source could shadow nuget.org and this package would
    be built against a Native version that was never published.

    LOCAL VERIFICATION ESCAPE HATCH (-p:UseLocalNativeProject=true): it swaps the PackageReference for a
    ProjectReference so a local build compiles this project against THIS repo's Native source, for building
    before Native is published or for developing a Native change and this package together. Local mode can
    never be packed (the guard below) and forces GeneratePackageOnBuild off, because a package built that way
    would depend on a Native version that does not exist. The default is false: a normal build uses the
    published Native pinned below.
  -->
  <PropertyGroup>
    <UseLocalNativeProject Condition="'$(UseLocalNativeProject)' == ''">false</UseLocalNativeProject>
    <GeneratePackageOnBuild Condition="'$(UseLocalNativeProject)' == 'true'">false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalNativeProject)' != 'true'">
    <!-- The PUBLISHED CodeBrix.WebGpu.Native.MitLicenseForever version this package depends on; moves with every Native publish (MAINTAINER-README.txt, HOW SKIA AND GRAPHICS REFERENCE NATIVE). -->
    <PackageReference Include="CodeBrix.WebGpu.Native.MitLicenseForever" Version="1.0.300.210" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalNativeProject)' == 'true'">
    <ProjectReference Include="..\CodeBrix.WebGpu.Native\CodeBrix.WebGpu.Native.csproj" />
  </ItemGroup>

  <Target Name="_BlockPackWithLocalNativeProject" BeforeTargets="GenerateNuspec;Pack" Condition="'$(UseLocalNativeProject)' == 'true'">
    <Error Text="UseLocalNativeProject=true is for local development only. The resulting package would depend on a CodeBrix.WebGpu.Native version that was never published. Publish CodeBrix.WebGpu.Native first, then flip the UseLocalNativeProject default in this project to false and pin the published Native version." />
  </Target>

  <!--
    Records in the assembly how this build consumed Native - AssemblyMetadata "CodeBrix.WebGpu.Native.Reference"
    = Project or Package, and in package mode "CodeBrix.WebGpu.Native.PackageVersion" = the pinned version - so
    the package tests can skip in local mode (no package is built) and check that the nupkg depends on exactly
    the pinned Native version.
  -->
  <Target Name="_StampNativeReference" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_PinnedWebGpuNative Include="@(PackageReference-&gt;WithMetadataValue('Identity', 'CodeBrix.WebGpu.Native.MitLicenseForever'))" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>CodeBrix.WebGpu.Native.Reference</_Parameter1>
        <_Parameter2 Condition="'$(UseLocalNativeProject)' == 'true'">Project</_Parameter2>
        <_Parameter2 Condition="'$(UseLocalNativeProject)' != 'true'">Package</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(UseLocalNativeProject)' != 'true'">
        <_Parameter1>CodeBrix.WebGpu.Native.PackageVersion</_Parameter1>
        <_Parameter2>@(_PinnedWebGpuNative->'%(Version)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    The icon, LICENSE and the third-party notices come from the repo root and cover both packages; the README
    and the agent guide are this package's OWN, living beside this csproj, because the root ones describe
    CodeBrix.WebGpu.Native. Files inside the project folder are already part of the SDK's default None glob,
    so they are packed with Update rather than Include.
  -->
  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Update="README.md" Pack="true" PackagePath="" />
    <None Update="AGENT-README.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
