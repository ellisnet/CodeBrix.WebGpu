using System;
using System.Globalization;
using System.Runtime.InteropServices;

namespace CodeBrix.WebGpu.Native;
{{ for h in Items }}

{{ h.Doc }}
[StructLayout(LayoutKind.Sequential)]
public readonly struct {{ h.Name }} : IEquatable<{{ h.Name }}>
{
    /// <summary>The native <c>{{ h.CName }}</c> pointer; zero for none.</summary>
    public readonly IntPtr Handle;

    /// <summary>Wraps a native <c>{{ h.CName }}</c> pointer.</summary>
    /// <param name="handle">The pointer (zero for none).</param>
    public {{ h.Name }}(IntPtr handle)
    {
        Handle = handle;
    }

    /// <summary>The null handle.</summary>
    public static {{ h.Name }} Null => default;

    /// <summary>True when the handle is null.</summary>
    public bool IsNull => Handle == IntPtr.Zero;

    /// <summary>Compares the native pointers.</summary>
    /// <param name="other">The other handle.</param>
    /// <returns>True when both wrap the same pointer.</returns>
    public bool Equals({{ h.Name }} other) => Handle == other.Handle;

    /// <summary>Compares the native pointers.</summary>
    /// <param name="obj">The other object.</param>
    /// <returns>True when <paramref name="obj" /> is a <see cref="{{ h.Name }}" /> wrapping the same pointer.</returns>
    public override bool Equals(object obj) => obj is {{ h.Name }} other && Equals(other);

    /// <summary>The hash of the native pointer.</summary>
    /// <returns>The hash code.</returns>
    public override int GetHashCode() => Handle.GetHashCode();

    /// <summary>The type name and the native pointer in hexadecimal.</summary>
    /// <returns>For example <c>{{ h.Name }}(0x7F0012345678)</c>.</returns>
    public override string ToString() => "{{ h.Name }}(0x" + Handle.ToString("X", CultureInfo.InvariantCulture) + ")";

    /// <summary>Compares the native pointers.</summary>
    /// <param name="left">The first handle.</param>
    /// <param name="right">The second handle.</param>
    /// <returns>True when both wrap the same pointer.</returns>
    public static bool operator ==({{ h.Name }} left, {{ h.Name }} right) => left.Handle == right.Handle;

    /// <summary>Compares the native pointers.</summary>
    /// <param name="left">The first handle.</param>
    /// <param name="right">The second handle.</param>
    /// <returns>True when the pointers differ.</returns>
    public static bool operator !=({{ h.Name }} left, {{ h.Name }} right) => left.Handle != right.Handle;
}
