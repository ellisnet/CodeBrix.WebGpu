# ==============================================================================================
# pins.env - EVERY version / digest / option pin used by wgpu-native-tools.
# Edit here only. The Linux, Android, Windows and macOS scripts all read this file (the Windows
# scripts parse it), and every build echoes the values it used into its BUILD-INFO.txt.
# ==============================================================================================

# --- Upstream (vendored in-repo; see ../UPSTREAM.txt and ../refresh-upstream.sh) ----------------
WGPU_NATIVE_DIR=wgpu-native
# The wgpu-native release tag. Also exported as WGPU_NATIVE_VERSION to every cargo build: it is
# what wgpu-native's wgpuGetVersion() bakes in (and codebrix-wgpu/build.rs refuses to build
# without it).
WGPU_NATIVE_TAG=v29.0.1.1
WGPU_NATIVE_TARBALL_SHA256=6008651e1d10022d4ded15b69405b4ba88577be5d623938ba98ad241b2cbf818
WEBGPU_HEADERS_COMMIT=673658bc2bd70ec39fc55ebe6bb0173cf6d0a603
WEBGPU_HEADERS_TARBALL_SHA256=6754c6c2465c79a954f7c04c7890c9f00b7ecce8addbe01b5056e860ba3933e6
# The wgpu crates the lock resolves (informational; Cargo.lock is the pin).
WGPU_CORE_VERSION=29.0.3

# --- Rust toolchain ------------------------------------------------------------------------------
# wgpu-native v29.0.1.1's rust-toolchain.toml says channel "1.93". The shipped builds use exactly
# that release (the derived Linux images install it; Windows / macOS scripts call cargo +<this>).
RUST_TOOLCHAIN=1.93

# --- Container images (Linux) -----------------------------------------------------------------------
# The manylinux images fix the glibc baseline (2.28 / 2.28 / 2.39). The same three images, tags
# and digests every CodeBrix Linux native pins (CodeBrix.Audio.FlacWriter, Vorbis, Sdl3, ...).
IMAGE_X64=quay.io/pypa/manylinux_2_28_x86_64:2026.07.19-1
IMAGE_X64_DIGEST=sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
IMAGE_ARM64=quay.io/pypa/manylinux_2_28_aarch64:2026.07.19-1
IMAGE_ARM64_DIGEST=sha256:162c81dfd3efc710732a571717d3c916a6945ebf279e879ddee3243af96fe46f
IMAGE_RISCV64=quay.io/pypa/manylinux_2_39_riscv64:2026.07.19-1
IMAGE_RISCV64_DIGEST=sha256:04b3acc69a6cebb10ac1252587d202acce6445d91c783d3f92229bb2b2483069

# The derived images (Containerfile.<arch>) ADD what a Rust build needs to the manylinux base:
# rustup + RUST_TOOLCHAIN + the target, and clang / libclang (wgpu-native's bindgen). Building
# them is the ONE container step that uses the network (the 2026-08-28 "install tools in the
# derived image" ruling); the library build itself runs with --network none.
DERIVED_IMAGE_PREFIX=codebrix-wgpu-build
# Labels on every derived image, container and volume this tooling creates (cleanup finds them).
LABEL_PREFIX=codebrix.webgpu.natives
# The cargo registry cache volume (filled by the `cargo fetch` step, read by the offline build).
CARGO_CACHE_VOLUME=codebrix-wgpu-cargo-cache

# --- Android -------------------------------------------------------------------------------------
NDK_PIN=30.0.16248370
ANDROID_API=33

# --- macOS -------------------------------------------------------------------------------------------
MACOS_DEPLOYMENT_TARGET=11.0

# --- The shipped library -------------------------------------------------------------------------
LIB_NAME=libcodebrix_wgpu.so
LIB_SONAME=libcodebrix_wgpu.so
LICENSE_NAME=LICENSE-WgpuNative.txt

# --- Verification gate -----------------------------------------------------------------------------
GLIBC_MAX_X64=2.28
GLIBC_MAX_ARM64=2.28
GLIBC_MAX_RISCV64=2.39
# Shared libraries the .so may depend on. wgpu loads libvulkan / libEGL / libGL at RUN time
# (dlopen); a link-time dependency on them is a gate failure.
ALLOWED_DEPS="libc.so.6 libm.so.6 libdl.so.2 libpthread.so.0 libgcc_s.so.1 librt.so.1 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1 ld-linux-riscv64-lp64d.so.1"
# The exact export set: ../specs/expected-exports.txt (generated from the three YAMLs by the
# binding generator; one symbol per line, '#' comments). Every gate compares the binary's
# exports to it - nothing missing, nothing extra.
EXPECTED_EXPORTS_FILE=specs/expected-exports.txt
