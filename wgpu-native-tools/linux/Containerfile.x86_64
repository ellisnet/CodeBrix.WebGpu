# =============================================================================================
# Containerfile.x86_64 - the codebrix_wgpu build machine for linux-x64 (and the cross builds of
#                        linux-arm64 / linux-riscv64)
# =============================================================================================
#
# WHAT THIS IS
#   The digest-pinned manylinux_2_28_x86_64 image (AlmaLinux 8, gcc-toolset 14, glibc 2.28) with
#   what a Rust build of wgpu-native needs ADDED ON TOP - this is the one container step that uses
#   the network (the "install the tools in the derived image" ruling of 2026-08-28):
#     * clang + clang-libs (libclang, for wgpu-native's bindgen step) + lld (the cross linker),
#       from the distribution (dnf);
#     * rustup + the pinned Rust toolchain (RUST_TOOLCHAIN in pins.env; profile minimal) and the
#       aarch64 / riscv64gc Linux targets, under CARGO_HOME=/usr/local/cargo and
#       RUSTUP_HOME=/usr/local/rustup (the official rust image's layout, which
#       CodeBrix.RustTools.Docker's containers expect: its cargo cache volume mounts at
#       /usr/local/cargo/registry);
#     * the CROSS SYSROOTS: glibc + kernel headers + the GCC support files of the pinned
#       manylinux_2_28_aarch64 and manylinux_2_39_riscv64 images (sysroot-<arch>.tar, made by
#       export-sysroot.sh from those images), so a library linked here for those architectures
#       has exactly the glibc floor a native build in their image would have (2.28 / 2.39);
#     * <prefix>-gcc / -g++ / -ar wrappers (aarch64-linux-gnu-, riscv64-linux-gnu-) - the GNU
#       cross-tool names CodeBrix.RustTools' LinuxLinkProfile points cargo at - which run
#       clang --target=<arch>-redhat-linux --sysroot=/opt/sysroot/<arch> -fuse-ld=lld.
#   It then PROBES everything (a C program cross-linked for each architecture, cargo/rustc
#   versions) and records the versions in /usr/local/share/codebrix-wgpu-build/toolchain.txt,
#   which every BUILD-INFO.txt copies.
#
#   The library build itself runs in this image with --network none (linux/build.sh), reading the
#   crates `cargo fetch` put in the cargo cache volume.
#
#   build.sh builds this image the first time it is needed and reuses it after that.
#   To rebuild deliberately:   FORCE_IMAGE_REBUILD=1 ./build.sh x64
#
# The default ARGs exist only so a hand-run build works; build.sh passes them from pins.env.
# =============================================================================================

ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64@sha256:a61875a2f84cab7df8de222ff12cabc08ff86eb4ad402ac90ba7bdaed9600cca
FROM ${BASE_IMAGE}
ARG RUST_TOOLCHAIN=1.93

LABEL org.opencontainers.image.title="codebrix-wgpu-build-x86_64"
LABEL org.opencontainers.image.description="codebrix_wgpu native build machine: manylinux_2_28_x86_64 + clang/lld + Rust + aarch64/riscv64 cross sysroots"
LABEL org.opencontainers.image.source="CodeBrix.WebGpu/wgpu-native-tools/linux/Containerfile.x86_64"
LABEL codebrix.webgpu.natives=1

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    CARGO_TERM_COLOR=never \
    RUSTUP_AUTO_INSTALL=0

# --- distribution tools (network) ----------------------------------------------------------------
RUN set -eu; \
    dnf install -y --setopt=install_weak_deps=False clang clang-libs lld llvm; \
    dnf clean all; rm -rf /var/cache/dnf

# --- Rust (network) ---------------------------------------------------------------------------------
RUN set -eu; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh; \
    sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal --default-toolchain "${RUST_TOOLCHAIN}"; \
    rm -f /tmp/rustup-init.sh; \
    rustup target add aarch64-unknown-linux-gnu riscv64gc-unknown-linux-gnu; \
    chmod -R a+rwX /usr/local/cargo /usr/local/rustup

# --- cross sysroots + GNU-named cross wrappers (no network) -------------------------------------------
ADD sysroot-aarch64.tar /opt/sysroot/aarch64/
ADD sysroot-riscv64.tar /opt/sysroot/riscv64/
RUN set -eu; \
    for a in aarch64 riscv64; do \
        ln -sfn usr/lib /opt/sysroot/$a/lib; ln -sfn usr/lib64 /opt/sysroot/$a/lib64; \
        for t in gcc g++; do \
            drv=clang; [ "$t" = "g++" ] && drv=clang++; \
            printf '#!/bin/sh\n# %s cross %s for the pinned manylinux %s userland (Containerfile.x86_64)\nexec %s --target=%s-redhat-linux --sysroot=/opt/sysroot/%s -fuse-ld=lld "$@"\n' \
                "$a" "$t" "$a" "$drv" "$a" "$a" > /usr/local/bin/$a-linux-gnu-$t; \
            chmod 755 /usr/local/bin/$a-linux-gnu-$t; \
        done; \
        ln -sfn /usr/bin/llvm-ar /usr/local/bin/$a-linux-gnu-ar; \
        ln -sfn /usr/bin/llvm-ranlib /usr/local/bin/$a-linux-gnu-ranlib; \
    done

# bindgen (wgpu-native's build script) parses webgpu.h for the TARGET: give it the target's headers.
ENV BINDGEN_EXTRA_CLANG_ARGS_aarch64_unknown_linux_gnu="--sysroot=/opt/sysroot/aarch64" \
    BINDGEN_EXTRA_CLANG_ARGS_riscv64gc_unknown_linux_gnu="--sysroot=/opt/sysroot/riscv64 --target=riscv64-redhat-linux"

# --- probe: everything above works, versions recorded ------------------------------------------------
RUN set -eu; \
    for t in cc clang lld llvm-ar cargo rustc rustup file nm objdump readelf strip ldd sha256sum patch; do \
        command -v "$t" > /dev/null 2>&1 || { echo "ERROR: $t is missing from the image." >&2; exit 1; }; \
    done; \
    ls /usr/lib64/libclang.so* > /dev/null; \
    printf '#include <math.h>\n#include <stdio.h>\nint f(double x){ return (int)sqrt(x); }\n' > /tmp/p.c; \
    for a in aarch64 riscv64; do \
        $a-linux-gnu-gcc -shared -fPIC -O1 -o /tmp/p-$a.so /tmp/p.c -lm; file /tmp/p-$a.so; \
    done; \
    mkdir -p /usr/local/share/codebrix-wgpu-build; \
    out=/usr/local/share/codebrix-wgpu-build/toolchain.txt; \
    { \
      echo "os      : $(grep -m1 PRETTY_NAME /etc/os-release | cut -d= -f2- | tr -d '\"')"; \
      echo "machine : $(uname -m)"; \
      echo "cc      : $(cc --version | sed -n 1p)"; \
      echo "ld      : $(ld --version | sed -n 1p)"; \
      echo "glibc   : $(ldd --version | sed -n 1p)"; \
      echo "clang   : $(clang --version | sed -n 1p)"; \
      echo "lld     : $(ld.lld --version | sed -n 1p)"; \
      echo "libclang: $(ls /usr/lib64/libclang.so.* | sed -n 1p)"; \
      echo "rustup  : $(rustup --version 2>/dev/null | sed -n 1p)"; \
      echo "rustc   : $(rustc --version)"; \
      echo "cargo   : $(cargo --version)"; \
      echo "targets : $(rustup target list --installed | tr '\n' ' ')"; \
      echo "sysroot aarch64: glibc $(ls /opt/sysroot/aarch64/usr/lib64/libc-*.so 2>/dev/null | sed 's/.*libc-//; s/\.so//' | sed -n 1p) (manylinux_2_28_aarch64)"; \
      echo "sysroot riscv64: $(ls /opt/sysroot/riscv64/usr/lib/gcc/) gcc $(ls /opt/sysroot/riscv64/usr/lib/gcc/*/) (manylinux_2_39_riscv64, glibc 2.39)"; \
    } > "$out"; \
    cat "$out"; rm -f /tmp/p.c /tmp/p-*.so; \
    echo "toolchain: ok"

WORKDIR /work
