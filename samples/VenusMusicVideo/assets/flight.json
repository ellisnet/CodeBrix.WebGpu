    { "t": "1:14", "over": [60, -25], "alt": 1250, "note": "Lakshmi Planum, turning south" },
    { "t": "1:30", "over": [36, -50], "alt": 1300 },
    { "t": "1:46", "over": [10, -72], "alt": 1300 },
    { "t": "2:02", "over": [-8, -95], "alt": 1200, "note": "along the equatorial band" },
