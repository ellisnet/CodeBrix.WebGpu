<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>33</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>WebGpuModelViewer</RootNamespace>
    <AssemblyName>WebGpuModelViewer.Android</AssemblyName>
    <ApplicationId>com.codebrix.webgpumodelviewer</ApplicationId>
    <ApplicationTitle>WebGpuModelViewer</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- A self-contained sample APK: the signed package in bin/ installs with a plain "adb install". -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.WebGpu.Graphics\CodeBrix.WebGpu.Graphics.csproj" />
    <ProjectReference Include="..\..\src\CodeBrix.WebGpu.Skia\CodeBrix.WebGpu.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Graphics3D.Gltf2.MitLicenseForever" Version="1.0.290.996" />
    <PackageReference Include="CodeBrix.Sdl3.ZlibLicenseForever" Version="1.0.275.85" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="4.153.1" />
  </ItemGroup>

  <!--
    The viewer itself (scene, renderer, HUD) is the desktop sample's code, linked in. Only the hosting differs: the
    desktop Program and its window/headless runners are left out, and Hosting/ here replaces them.
  -->
  <ItemGroup>
    <Compile Include="..\WebGpuModelViewer\**\*.cs"
             Exclude="..\WebGpuModelViewer\Program.cs;..\WebGpuModelViewer\Hosting\**;..\WebGpuModelViewer\bin\**;..\WebGpuModelViewer\obj\**"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The Native project's committed Android libraries, packaged into the APK's lib/<abi>/ folders. Needed only when
    Native comes in as a ProjectReference (the projects built with -p:UseLocalNativeProject=true), which brings no
    native binaries. When the Native PACKAGE is among the resolved package assets it brings the same libraries
    itself, so the target below drops these items again and the package's libraries are the only ones packaged.
  -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\..\src\CodeBrix.WebGpu.Native\runtimes\android-arm64\native\libcodebrix_wgpu.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="..\..\src\CodeBrix.WebGpu.Native\runtimes\android-x64\native\libcodebrix_wgpu.so" Abi="x86_64" />
  </ItemGroup>

  <Target Name="_DropCommittedNativesWhenNativePackageResolved" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_WebGpuNativePackageAsset Include="@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'CodeBrix.WebGpu.Native.MitLicenseForever'))" />
      <_WebGpuNativePackageAsset Include="@(NativeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'CodeBrix.WebGpu.Native.MitLicenseForever'))" />
      <_WebGpuNativePackageAsset Include="@(RuntimeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'CodeBrix.WebGpu.Native.MitLicenseForever'))" />
      <AndroidNativeLibrary Remove="..\..\src\CodeBrix.WebGpu.Native\runtimes\**\*" Condition="'@(_WebGpuNativePackageAsset)' != ''" />
    </ItemGroup>
  </Target>

  <!--
    The desktop sample's models, textures and licence files, packaged as APK assets under the same relative paths.
    They are copied to the app's files folder on first start (the model loader reads files).
  -->
  <ItemGroup>
    <AndroidAsset Include="..\WebGpuModelViewer\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
