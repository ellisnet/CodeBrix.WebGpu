<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.WebGpu.Skia\CodeBrix.WebGpu.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.248.1071" />
    <!--
      The library references SkiaSharp alone and leaves the native assets to the application; the tests are an
      application. SkiaSharp itself brings the macOS and Windows native assets on net10.0; Linux needs this one.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>

  <!--
    The Native project's committed native libraries, copied to the output under runtimes/<rid>/native/ - the layout
    the Native library's DllImportResolver probes. Needed only when Native comes in as a ProjectReference (the
    projects built with -p:UseLocalNativeProject=true), which brings no native binaries. When the Native PACKAGE is
    among the resolved package assets it brings the same files itself, so the target below drops these items again
    and the package's natives are the only ones copied.
  -->
  <ItemGroup>
    <None Remove="..\..\src\CodeBrix.WebGpu.Native\runtimes\**\*" />
    <None Include="..\..\src\CodeBrix.WebGpu.Native\runtimes\**\*" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="_DropCommittedNativesWhenNativePackageResolved" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_WebGpuNativePackageAsset Include="@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'CodeBrix.WebGpu.Native.MitLicenseForever'))" />
      <_WebGpuNativePackageAsset Include="@(NativeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'CodeBrix.WebGpu.Native.MitLicenseForever'))" />
      <_WebGpuNativePackageAsset Include="@(RuntimeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'CodeBrix.WebGpu.Native.MitLicenseForever'))" />
      <None Remove="..\..\src\CodeBrix.WebGpu.Native\runtimes\**\*" Condition="'@(_WebGpuNativePackageAsset)' != ''" />
    </ItemGroup>
  </Target>

</Project>
